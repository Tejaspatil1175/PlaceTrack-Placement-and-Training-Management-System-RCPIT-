# Server Configuration
PORT=5000
NODE_ENV=development

# Railway Online MySQL Database Configuration
# Option A: Full Railway Connection URL (Recommended for Railway)
# e.g., mysql://root:password@roundhouse.proxy.rlwy.net:12345/railway
MYSQL_URL=
DATABASE_URL=

# Option B: Individual Railway MySQL Connection Variables
MYSQLHOST=
MYSQLPORT=
MYSQLDATABASE=railway
MYSQLUSER=root
MYSQLPASSWORD=
DB_DIALECT=mysql

# Fallback individual parameters (if not using Railway auto-injected vars)
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# JWT Authentication
JWT_SECRET=rcpit_placetrack_secret_key_2026_super_secure
JWT_EXPIRES_IN=7d

# Cloudinary (Student Resumes)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email / Nodemailer (Gmail App Password / SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=PlaceTrack RCPIT <noreply@rcpit.ac.in>
